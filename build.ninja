cc = gcc
cflags = -std=c11 -Wall -Wextra -Wpedantic -g -Iinclude

rule compile
  command = $cc $cflags -c $in -o $out
  description = Compiling $in

rule link
  command = $cc $ldflags $in -o $out
  description = Linking $out

build src/main.o: compile src/main.c
build src/cmd.o: compile src/cmd.c
build src/level.o: compile src/level.c
build src/lib.o: compile src/lib.c
build gsmanufacturing: link src/main.o src/cmd.o src/level.o src/lib.o

default gsmanufacturing
