cxx = x86_64-w64-mingw32-g++
cflags = -std=c++20 -Wall -Wextra -Wpedantic -Isrc -Ithirdparty/libtrippin -Ithirdparty/imgui -Ithirdparty/imgui/backends -Iwindows/include -Og -g -DDEBUG -D_DEBUG -fno-omit-frame-pointer
ldflags = -lgdi32 -lopengl32 -static

rule compile
  command = $cxx $cflags -c $in -o $out
  description = Compiling $in

rule link
  command = $cxx $in windows/lib/libglfw3.a $ldflags -o $out
  description = Linking $out

build thirdparty/libtrippin/trippin/common.o: compile thirdparty/libtrippin/trippin/common.cpp
build thirdparty/libtrippin/trippin/error.o: compile thirdparty/libtrippin/trippin/error.cpp
build thirdparty/libtrippin/trippin/iofs.o: compile thirdparty/libtrippin/trippin/iofs.cpp
build thirdparty/libtrippin/trippin/log.o: compile thirdparty/libtrippin/trippin/log.cpp
build thirdparty/libtrippin/trippin/math.o: compile thirdparty/libtrippin/trippin/math.cpp
build thirdparty/libtrippin/trippin/memory.o: compile thirdparty/libtrippin/trippin/memory.cpp
build thirdparty/libtrippin/trippin/string.o: compile thirdparty/libtrippin/trippin/string.cpp
build thirdparty/libtrippin/trippin/util.o: compile thirdparty/libtrippin/trippin/util.cpp
build src/main.o: compile src/main.cpp
build src/window.o: compile src/window.cpp
build src/state.o: compile src/state.cpp
build gsmith: link src/main.o src/window.o src/state.o thirdparty/libtrippin/trippin/common.o thirdparty/libtrippin/trippin/error.o thirdparty/libtrippin/trippin/iofs.o thirdparty/libtrippin/trippin/log.o thirdparty/libtrippin/trippin/math.o thirdparty/libtrippin/trippin/memory.o thirdparty/libtrippin/trippin/string.o thirdparty/libtrippin/trippin/util.o

default gsmith
